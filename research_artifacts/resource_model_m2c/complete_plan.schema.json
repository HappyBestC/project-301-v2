{
  "$defs": {
    "CompleteAction": {
      "additionalProperties": false,
      "properties": {
        "action_instance_id": {
          "title": "Action Instance Id",
          "type": "string"
        },
        "action_type": {
          "enum": [
            "control_external_bleeding",
            "fluid_resuscitation",
            "transfusion",
            "control_internal_bleeding",
            "occlusive_dressing",
            "needle_decompression",
            "control_hemothorax_bleeding",
            "chest_tube",
            "intubation",
            "mechanical_ventilation",
            "supplemental_oxygen",
            "remove_from_exposure"
          ],
          "title": "Action Type",
          "type": "string"
        },
        "side": {
          "anyOf": [
            {
              "enum": [
                "Left",
                "Right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Side"
        },
        "compartment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compartment"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        }
      },
      "required": [
        "action_instance_id",
        "action_type",
        "depends_on"
      ],
      "title": "CompleteAction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "patient_id": {
      "title": "Patient Id",
      "type": "string"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "scope_kind": {
      "enum": [
        "research_fixture",
        "clinical_design"
      ],
      "title": "Scope Kind",
      "type": "string"
    },
    "scope_id": {
      "title": "Scope Id",
      "type": "string"
    },
    "severity": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Severity"
    },
    "location_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Location Id"
    },
    "actions": {
      "items": {
        "$ref": "#/$defs/CompleteAction"
      },
      "title": "Actions",
      "type": "array"
    },
    "schema_version": {
      "const": "301.treatment.complete.1",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "execution_policy": {
      "const": "m2a_serial_execution",
      "title": "Execution Policy",
      "type": "string"
    },
    "parameter_policy": {
      "const": "fixed_profile_no_overrides",
      "title": "Parameter Policy",
      "type": "string"
    }
  },
  "required": [
    "patient_id",
    "plan_id",
    "scope_kind",
    "scope_id",
    "location_id",
    "actions",
    "schema_version",
    "run_id",
    "execution_policy",
    "parameter_policy"
  ],
  "title": "CompletePlan",
  "type": "object"
}
